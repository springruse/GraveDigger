<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- ============================================ -->
	<!-- VETERAN -->
	<!-- ============================================ -->
    <TraitDef>
        <defName>Veteran</defName>
        <commonality>0.3</commonality>
        <degreeDatas>
            <li>
                <label>veteran</label>
                <description>{PAWN_nameDef} is a longtime veteran of war, seeing many battles, hardships and defeats. {PAWN_pronoun} is hardened through experience, being better with ranged and melee weapons. {PAWN_pronoun} refuses to discuss {PAWN_possessive} time as a soldier, communicating poorly as a result.</description>
                <possessions>
                    <GD_CavalrySword/>
                    <GD_GraceRevolver/>
                </possessions>
                <allowedMeditationFocusTypes>
                    <li>Morbid</li>
                </allowedMeditationFocusTypes>
                <statOffsets>
                    <MentalBreakThreshold>-0.05</MentalBreakThreshold>
                    <ShootingAccuracyPawn>2</ShootingAccuracyPawn>
                    <AimingDelayFactor>-0.2</AimingDelayFactor>
                    <MeleeHitChance>2</MeleeHitChance>
                    <SocialImpact>-0.5</SocialImpact>
                    <NegotiationAbility>-0.5</NegotiationAbility>
                    <TradePriceImprovement>-0.5</TradePriceImprovement>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Violent</li>
        </requiredWorkTags>
        <conflictingTraits>
            <li>Wimp</li>
            <li>Kind</li>
        </conflictingTraits>
    </TraitDef>
    <!-- ============================================ -->
	<!-- SURVIVALIST -->
	<!-- ============================================ -->
    <TraitDef>
        <defName>Survivalist</defName>
        <commonality>0.8</commonality>
        <degreeDatas>
            <li>
                <label>survivalist</label>
                <description>{PAWN_nameDef} is long-term prepper, thinking ahead of potential disasters and preparing accordingly. {PAWN_pronoun} also pushes on through harsher environments and consumes half as much food than the average colonist.</description>
                <possessions>
                    <MealSurvivalPack>10</MealSurvivalPack>
                </possessions>
                <hungerRateFactor>0.5</hungerRateFactor>
                <statOffsets>
                    <ComfyTemperatureMin>-10</ComfyTemperatureMin>
                    <ComfyTemperatureMax>10</ComfyTemperatureMax>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>
    <!-- ============================================ -->
	<!-- CHEMIST -->
	<!-- ============================================ -->
    <TraitDef>
        <defName>Chemist</defName>
        <commonality>0.5</commonality>
        <degreeDatas>
            <li>
                <label>chemist</label>
                <description>{PAWN_nameDef} is trained in chemistry and is highly knowledgeable toward the human body. {PAWN_pronoun} sees the body as a easy to read system and is skilled at diagnosing and treating medical conditions.</description>
                <possessions>
                    <MedicineIndustrial>5</MedicineIndustrial>
                </possessions>
                <skillGains>
                    <Medicine>2</Medicine>
                </skillGains>
                <statOffsets>
                    <MedicalTendQuality>0.2</MedicalTendQuality>
                    <MedicalTendSpeed>0.2</MedicalTendSpeed>
                    <MedicalOperationSpeed>0.2</MedicalOperationSpeed>
                </statOffsets>
            </li>
        </degreeDatas>
        <requiredWorkTags>
            <li>Caring</li>
        </requiredWorkTags>
    </TraitDef>
</Defs>